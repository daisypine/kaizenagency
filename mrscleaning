  .kanji{position:absolute;top:-38px;right:-14px;font-family:"Fraunces",serif;font-size:230px;line-height:1;color:var(--jade);opacity:.06;user-select:none;pointer-events:none;}
  .brand{display:flex;align-items:baseline;gap:10px;font-family:"Fraunces",serif;font-weight:600;font-size:24px;letter-spacing:-.01em;position:relative;}
  .brand .dot{color:var(--jade);}
  .brand small{font-family:"Inter",sans-serif;font-weight:500;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);}
  .doc-title{font-family:"Fraunces",serif;font-weight:600;font-size:40px;line-height:1.08;letter-spacing:-.02em;margin-top:26px;max-width:16ch;}
  .doc-sub{font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--jade);font-weight:600;margin-top:14px;}
  .meta{display:grid;grid-template-columns:repeat(3,1fr);gap:2px 24px;margin-top:30px;border-top:1px solid var(--line-soft);padding-top:22px;}
  .meta .k{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:3px;}
  .meta .v{font-weight:500;font-size:14.5px;}
  .body{padding:44px 48px 12px;}
  section{margin-bottom:40px;}
  .eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:16px;}
  .eyebrow .num{font-family:"Fraunces",serif;font-weight:600;font-size:13px;color:var(--jade);background:var(--tint);width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;}
  h2{font-family:"Fraunces",serif;font-weight:600;font-size:23px;letter-spacing:-.01em;}
  p{margin-bottom:12px;}p:last-child{margin-bottom:0;}
  .muted{color:var(--muted);}
  .svc{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line-soft);border:1px solid var(--line-soft);border-radius:6px;overflow:hidden;}
  .svc .cell{background:var(--paper);padding:18px 20px;}
  .svc h3{font-family:"Fraunces",serif;font-size:17px;font-weight:600;margin-bottom:5px;display:flex;align-items:center;gap:9px;}
  .svc h3::before{content:"";width:7px;height:7px;background:var(--jade);border-radius:50%;flex:none;}
  .svc p{font-size:13.5px;color:var(--muted);margin:0;line-height:1.55;}
  .flow{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px;}
  .flow .step{flex:1 1 140px;border:1px solid var(--line);border-radius:6px;padding:14px 16px;position:relative;}
  .flow .step .s{font-family:"Fraunces",serif;color:var(--jade);font-weight:600;font-size:13px;}
  .flow .step .t{font-weight:600;font-size:14.5px;margin-top:2px;}
  .flow .step .d{font-size:12.5px;color:var(--muted);margin-top:3px;line-height:1.5;}
  .tl{border-top:1px solid var(--line);}
  .tl .row{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:15px 12px;border-bottom:1px solid var(--line-soft);align-items:baseline;}
  .tl .row.cur{background:linear-gradient(90deg,var(--tint),transparent);border-radius:6px;}
  .tl .m{font-family:"Fraunces",serif;font-weight:600;font-size:15px;color:var(--jade-deep);}
  .tl .row.cur .m{color:var(--jade);}
  .tl .desc{font-size:14.5px;}
  .badge{display:inline-block;font-size:9.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:var(--jade);padding:2px 8px;border-radius:100px;margin-left:8px;vertical-align:middle;}
  .note{font-size:13px;color:var(--muted);margin-top:14px;font-style:italic;}
  .inv{background:var(--ink);color:#EAF0EE;border-radius:8px;padding:28px 30px;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;}
  .inv .big{font-family:"Fraunces",serif;font-size:38px;font-weight:600;line-height:1;color:#fff;}
  .inv .big span{font-size:17px;color:#9FBDB4;font-weight:400;}
  .inv .lab{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8FAAA2;margin-bottom:6px;}
  .inv .tot{text-align:right;}
  .inv .tot .t2{font-family:"Fraunces",serif;font-size:22px;color:#fff;font-weight:500;}
  .ongoing{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:4px 0 16px;}
  .ongoing .tier{border:1px solid var(--line);border-radius:8px;padding:18px 20px;}
  .ongoing .tier.free{background:var(--tint);border-color:var(--jade);}
  .ongoing .tier .yr{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);}
  .ongoing .tier .amt{font-family:"Fraunces",serif;font-size:27px;font-weight:600;margin-top:5px;line-height:1;}
  .ongoing .tier .amt span{font-size:13.5px;color:var(--muted);font-weight:400;}
  .ongoing .tier .sub{font-size:12.5px;color:var(--muted);margin-top:5px;}
  ul.clean{list-style:none;margin-top:4px;}
  ul.clean li{position:relative;padding-left:24px;margin-bottom:9px;font-size:14.5px;}
  ul.clean li::before{content:"";position:absolute;left:2px;top:9px;width:8px;height:8px;border:1.5px solid var(--jade);border-radius:2px;transform:rotate(45deg);}
  .callout{background:var(--tint);border-left:3px solid var(--jade);border-radius:0 6px 6px 0;padding:16px 20px;font-size:14.5px;}
  .callout strong{color:var(--jade-deep);}
  .accept{border-top:2px solid var(--ink);margin-top:8px;padding-top:34px;}
  .sig{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:26px;}
  .sig .box .line{border-bottom:1.5px solid var(--ink);height:44px;margin-bottom:8px;}
  .sig .box .lbl{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);}
  .sig .box .who{font-weight:600;font-size:14px;margin-top:2px;}
  footer{background:var(--ink);color:#B7C9C3;padding:26px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:13px;}
  footer .tag{font-family:"Fraunces",serif;font-style:italic;color:#7FA398;}
  footer a{color:#CFE0DA;text-decoration:none;}
  @media (max-width:640px){
    body{padding:14px 8px;}.head{padding:36px 24px 30px;}.body{padding:32px 24px 8px;}
    .doc-title{font-size:30px;}.kanji{font-size:150px;top:-20px;}
    .meta{grid-template-columns:1fr 1fr;gap:16px;}.svc{grid-template-columns:1fr;}
    .sig{grid-template-columns:1fr;gap:30px;}.inv{flex-direction:column;align-items:flex-start;}
    .inv .tot{text-align:left;}.ongoing{grid-template-columns:1fr;}footer{padding:22px 24px;}
    .tl .row{grid-template-columns:92px 1fr;gap:14px;}
  }
  @media print{
    body{background:#fff;padding:0;}.sheet{border:none;box-shadow:none;max-width:100%;}
    .lang-toggle{display:none;}
    .inv,footer{background:#1B2A2E !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
    section{break-inside:avoid;}
  }
</style>
</head>
